# Site branding — read by index.html (Vite's built-in %VITE_X% HTML interpolation)
# and by src/siteConfig.js (import.meta.env.VITE_X) so both the static <head>
# and the React components stay in sync from one place.
#
# This file is intentionally committed: it holds template placeholder copy,
# not secrets. If a real project needs actual secrets later, put those in
# .env.local instead (already gitignored via the `*.local` rule) — never here.

VITE_SITE_TITLE="Animated Scroll Experience"
VITE_SITE_DESCRIPTION="An immersive, scroll-driven animated experience built with React Three Fiber and GSAP. Featuring cinematic video scrubbing, explosion shaders, and smooth scroll transitions."
VITE_THEME_COLOR="#050505"
VITE_BRAND_NAME="BRAND"
VITE_COMPANY_NAME="COMPANY"
VITE_CONTACT_EMAIL="hello@studio.example"
